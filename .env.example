# MongoDB — local Docker or Atlas free cluster. Leave unset (or USE_MEMORY_DB=1) to run without Mongo.
# MONGODB_URI=mongodb://127.0.0.1:27017/boutique_market
USE_MEMORY_DB=1

# Public site URL (no trailing slash)
APP_URL=http://localhost:5177

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# First admin account (created on boot if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!admin

# Optional env overrides for store branding (also editable in Admin → Store)
STORE_NAME=Your Boutique
STORE_TAGLINE=Ethnic wear, made personal
STORE_OWNER=
STORE_PHONE=
STORE_WHATSAPP=
STORE_EMAIL=
STORE_ADDRESS=
STORE_ACCENT=#c4a35a

# Seed demo catalog (Ruhi's Boutique sample products) on empty database
SEED_DEMO=1

# PhonePe Payment Gateway (optional — sandbox checkout is used when unset)
# https://developer.phonepe.com/
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=
